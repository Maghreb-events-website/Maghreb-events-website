Options -MultiViews
RewriteEngine On
RewriteBase /frontend/

# Pass Authorization header
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
CGIPassAuth On

# CORS
<IfModule mod_headers.c>
    SetEnvIf Origin "^https://([a-z0-9-]+\\.)?jamie-datson\\.(com|co\\.uk)$" CORS_ORIGIN=$0
    Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Vary "Origin"
    Header always set Access-Control-Allow-Origin "https://jamie-datson.com" env=!CORS_ORIGIN
</IfModule>

# OPTIONS preflight direct response (static site)
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=204,L]

# Block sensitive (no PHP routing needed)
<FilesMatch "\\.(db|env|md|json|sqlite|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# No fallback to index.html - serve files direct or 404
