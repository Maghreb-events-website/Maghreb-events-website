# Copy this file to `server/.env` and fill in real values.
# server/.env is git-ignored - NEVER commit real secrets.

# VATSIM Connect (OAuth2) SANDBOX credentials
# Get these from https://auth-dev.vatsim.net -> "Manage OAuth organizations"
VATSIM_CLIENT_ID=1496
VATSIM_CLIENT_SECRET=replace-with-your-sandbox-client-secret

# Must exactly match the redirect URI registered for the client
VATSIM_REDIRECT_URI=http://localhost:5173/login

# Sandbox auth server. For production this becomes https://auth.vatsim.net
VATSIM_AUTH_BASE=https://auth-dev.vatsim.net

# Space-separated list of scopes to request
VATSIM_SCOPES=full_name email vatsim_details

# Random long string used to sign the session cookie (JWT).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Where the Vue dev server runs (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

PORT=3001
