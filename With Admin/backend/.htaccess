Options -MultiViews
RewriteEngine On
RewriteBase /

# ── mod_security — relax rules that break OAuth/JSON ─────────────────────────
<IfModule mod_security2.c>
    SecRuleRemoveById 960010 960015 960013 920350 920420 933150 941100 949110 959180 973309 981137 981249
    LimitRequestBody 65536
    LimitRequestLine 8190
</IfModule>

# ── Authorization header passthrough ─────────────────────────────────────────
# Apache strips the Authorization header in CGI/FastCGI mode.
# All three methods used for maximum compatibility.

# Method 1: RewriteRule env (mod_rewrite)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Method 2: SetEnvIfNoCase (mod_setenvif) — inherited by PHP when mod_rewrite env is not
SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Method 3: CGIPassAuth — Apache 2.4.13+, silently ignored on older versions
CGIPassAuth On

# ── CORS — handle OPTIONS preflight FIRST, before routing ────────────────────
# This returns CORS headers + 204 immediately for OPTIONS without hitting PHP.
# This is the most reliable fix for "No Access-Control-Allow-Origin on preflight".

RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=204,L]

<IfModule mod_headers.c>
    # Always emit these on every response including the 204 above
    Header always set Access-Control-Allow-Origin "https://jamie-datson.com"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Auth-Token"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Vary "Origin"
</IfModule>

# ── Route everything else through index.php ──────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# ── Block direct access to sensitive files ───────────────────────────────────
<FilesMatch "\.(db|env|md|json|sqlite|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "vatsim_config.php">
    Order allow,deny
    Deny from all
</Files>

# ── Block direct access to data/ directory ───────────────────────────────────
RewriteRule ^data/ - [F,L]
